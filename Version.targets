<?xml version="1.0" encoding="utf-8"?>
<!-- Imported by the plugin and GUI projects: writes Version.h (see Write-Version.ps1) before they build. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="WriteFFBVersion" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Write-Version.ps1&quot;" />
  </Target>
</Project>
